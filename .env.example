# Required: your OpenAI API key (server-side only, never sent to the browser)
OPENAI_API_KEY=sk-...
# Optional: any chat model that supports Structured Outputs (json_schema)
OPENAI_MODEL=gpt-5.4-mini
# Optional: requests per minute per IP for /api/tutor (protects your API credits)
RATE_LIMIT_PER_MINUTE=20

# --- Free alternative: Google Gemini (OpenAI-compatible endpoint, free tier) ---
# Get a key at https://aistudio.google.com/apikey, then use instead of the values above:
# OPENAI_API_KEY=<your Gemini API key>
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-3.5-flash
